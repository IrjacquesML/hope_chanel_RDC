# Copiez ce fichier en .env et choisissez des identifiants solides.
# ADMIN_EMAIL / ADMIN_PASSWORD créent le premier administrateur au premier démarrage ;
# les autres comptes se gèrent ensuite dans l’administration (Comptes).
ADMIN_EMAIL=admin@exemple.org
ADMIN_PASSWORD=changez-moi-svp
PORT=3001
# Dernier recours si plus aucun administrateur ne peut se connecter : ADMIN_RESET=1, redémarrer, puis retirer la ligne
# ADMIN_RESET=1
# Base MySQL / MariaDB pour les comptes et le journal des connexions (sans MYSQL_DATABASE : fichiers db/*.json).
# Les tables sont créées au démarrage ; les comptes de db/users.json y sont repris la première fois.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=hopechanel_rdc
# MYSQL_USER=hopechanel
# MYSQL_PASSWORD=mot-de-passe-mysql
# NODE_ENV=production
# SITE_URL=https://www.hopechanelrdc.org
# Direct vMix auto-hébergé (MediaMTX sur la même machine, voir mediamtx/mediamtx.yml) : valeurs par défaut
# MEDIAMTX_HLS=http://127.0.0.1:8888
# MEDIAMTX_API=http://127.0.0.1:9997
# MEDIAMTX_BIN=C:\mediamtx\mediamtx.exe
# MEDIAMTX_AUTO=0
